# MongoDB
MONGO_URI=mongodb://localhost:27017/xpoll-registry

# JWT Secret
JWT_SECRET=your-secret-key-here

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ===== GEMINI API CONFIGURATION =====
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# ===== GOOGLE SHEETS API CONFIGURATION =====
# Path to your Google Service Account JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_KEY=./google-credentials.json
